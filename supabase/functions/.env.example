# Secrets for the edge functions: `supabase secrets set --env-file supabase/functions/.env`
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5-5
ANTHROPIC_MODEL=
SITE_URL=https://your-app.example.com

# WhatsApp Cloud API (sign-in codes and welcome message)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WA_EMAIL_DOMAIN=phone.meetalma.ai

# ElevenLabs (voice note transcription and read-aloud)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Calendar OAuth client (redirect URI: <SUPABASE_URL>/functions/v1/google-oauth-callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
